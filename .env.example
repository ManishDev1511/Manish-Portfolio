# ==============================================================================
# Manish Yadav Portfolio - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to configure local development or production secrets.
#
# 1. Email Delivery Configuration:
# Choose either 'resend' or 'smtp'. If left blank, the API uses sensible defaults
# or simulated mode with full client-side fallbacks.
# ==============================================================================

# Recipient email address where contact inquiries are forwarded
CONTACT_TO_EMAIL=manish.sp2060@gmail.com

# Verified sender address (e.g., for Resend: onboarding@resend.dev or your verified domain)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- OPTION A: RESEND (Recommended for modern serverless deployment) ---
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_api_key_here

# --- OPTION B: SMTP / NODEMAILER ---
# Alternative standard SMTP (e.g., Gmail App Password, Sendgrid, Postmark, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# ==============================================================================
# 2. Public Social Links & Site Metadata
# ==============================================================================
# Base URL for canonical tags and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GitHub profile link:
# If left blank, the UI gracefully omits GitHub links without showing broken URLs.
# Example: https://github.com/manish-yadav
NEXT_PUBLIC_GITHUB_URL=
